PORT=5002
APP_ORIGIN=http://localhost:5174
# json-demo is deliberately local, single-process synthetic storage.
STORE=json-demo
DEMO_MODE=true
DEMO_FILE=.data/interview-demo.json
# Production: STORE=mongo, DEMO_MODE=false, and supply a dedicated database.
MONGODB_URL=
MONGODB_DB=interview_lab_v1
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=10
AI_TIMEOUT_MS=25000
NODE_ENV=development

# Optional built frontend folder for a same-origin release
WEB_DIST=
AI_GLOBAL_DAILY_LIMIT=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
